# Polc titkok – másold le polc.env néven, és add hozzá a compose-hoz: env_file: [polc.env]
# Calibre-Web fiók (csak a szerver ismeri)
FEED_USERNAME=calibre-fiok
FEED_PASSWORD=calibre-jelszo

# Polc-felhasználók: nev:jelszo[:kindle@kindle.com]  (hash: docker exec -it polc python -m app.jelszo)
USERS=daniel:pbkdf2-260000-...:daniel@kindle.com,orsi:pbkdf2-260000-...

# E-mail küldés (opcionális)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=valaki@gmail.com
# SMTP_PASSWORD=alkalmazas-jelszo
# SMTP_FROM=valaki@gmail.com
